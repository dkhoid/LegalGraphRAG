# =============================================================================
# LegalGraphRAG Configuration File Example
# =============================================================================
# Copy this file to .env and modify configuration values according to your needs
# cp env.example .env

# -----------------------------------------------------------------------------
# 1. API KEYS (Manage all API keys here)
# -----------------------------------------------------------------------------
# Key for the Main Model (Feature Extraction & Final Output - STEP 1 & 4)
DEEPSEEK_API_KEY=

# Key for the Judge Model (LLM Judge - STEP 3) (Defaults to using DeepSeek's key)
GEMINI_API_KEY=

# Key for the Embedding Model (Vector Search - STEP 2)
EMBEDDING_API_KEY=

# (Optional) OpenAI Key if using gpt4o_mini instead of deepseek
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# 2. MODEL CONFIGURATION (Assign roles to models)
# -----------------------------------------------------------------------------
# Main Model: deepseek_v3, gpt4o_mini
model_name=deepseek_v3
base_url=https://api.deepseek.com/v1

# Judge Model (LLM Judge): deepseek_chat, gemini_flash_lite, gpt4o_mini
judge_chatbot=deepseek_chat

# Embedding Model (Text to Vector)
embedding_model=text-embedding-3-small
embedding_api_url=https://api.openai.com/v1/embeddings

# -----------------------------------------------------------------------------
# 3. NEO4J & GRAPH DATABASE
# -----------------------------------------------------------------------------
NEO4J_URI=neo4j+s://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

graph_db_path=./data/clean/graph.pkl
auto_save=True
auto_build=True

# -----------------------------------------------------------------------------
# 4. RAG PIPELINE THRESHOLDS (Adjust retrieval scope)
# -----------------------------------------------------------------------------
# Number of laws to retrieve from the Graph (Higher = more laws)
top_retrieve_top_k=5
direct_retrieve_top_k=5

# Number of laws allowed for Reranker and LLM Judge to process
reranker_top_k=8
mmr_top_k=5
max_judge_laws=8

# Maximum number of applicable laws retained after judging
max_applicable_laws=5

# Enable self-consistency? (3 passes per law - uses more API calls but improves accuracy)
use_self_consistent=False
self_consistent_n=3

# -----------------------------------------------------------------------------
# 5. DATA & OTHER CONFIGS
# -----------------------------------------------------------------------------
device=cpu
prompt_language=en
max_length=4096
temperature=0.1

case_db_path=./data/clean/cases_clean.json
law_to_dispute_path=./data/clean/law_to_dispute_clean.json
output_dir=./outputs

top_retrieve=True
direct_retrieve=True
augment_retrieve=True
# On 512MB RAM cloud instances (e.g. Render Free), set use_reranker=False to save RAM
use_reranker=True
use_mmr=True
mmr_lambda=0.5
min_rrf_score=0.01
expand_abbreviations=True
law_desc_cap=500
rrf_k=30
